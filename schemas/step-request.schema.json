{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/prakashjpn1-star/impulseatlas/schemas/step-request.schema.json",
  "title": "Bounded world advance",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "expected_tick": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ticks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600
    }
  },
  "required": [
    "run_id",
    "expected_tick",
    "ticks"
  ],
  "additionalProperties": false
}
